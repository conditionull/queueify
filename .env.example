# Run "npm start" and the setup dashboard fills most of this in for you.
# OBS_* and SP_DC are re-read while the bot runs, so saving a change here (or
# in the dashboard) takes effect on the next command - no restart needed.

TWITCH_BROADCASTER_USERNAME=
TWITCH_BOT_USERNAME=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/callback

# The setup page connects to OBS and lists your scenes and sources, so these
# names match OBS exactly. Typing them by hand is how !tr / !bc end up failing.
OBS_WEBSOCKET_PASSWORD=
OBS_WEBSOCKET_PORT=4455
OBS_WEBSOCKET_IP=127.0.0.1
OBS_SCENE=
OBS_SOURCE=

# Your sp_dc cookie from a logged-in Spotify session in your WEB browser.
# The setup page shows where to find it, and checks it for you.
SP_DC=
