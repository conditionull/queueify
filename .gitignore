.env
node_modules/

spotify-token.json
spotify-token.json.tmp

twitch-token.json
twitch-token.json.tmp

queue-settings.json
queue-history.json
queue-pending.json
queue-recent.json
queue-blacklist.json

config/settings.js

# Which theme belongs to which OBS scene - one person's scene names.
config/scene-themes.json

# Themes made in the editor belong to whoever made them, not to the project.
# The three hand-written ones ship with it.
widget/config.json
widget/themes/*
!widget/themes/default/
!widget/themes/minimal/
!widget/themes/swag/

.DS_Store
.parcel-cache
.vscode

# Workflows have to reach GitHub to run at all. Everything else under
# .github stays local - copilot-instructions.md is not published.
.github/*
!.github/workflows/
!.github/claude-review.md

# Local packaging tool and the tester instructions it bundles
zip.js
START-HERE.md
